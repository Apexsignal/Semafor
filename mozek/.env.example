# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # public, safe for the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # secret! server-only (agent run + API routes)

# Anthropic Claude — primární poskytovatel LLM (placený, žádné denní kvóty).
# Klíč: https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5                # optional override, see lib/agent.ts

# Gemini — záložní poskytovatel, použije se automaticky, když Claude selže
# (dojde kredit, špatný klíč, výpadek) nebo když ANTHROPIC_API_KEY chybí.
# Zdarma, bez karty: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ....
GEMINI_MODEL=gemini-3.6-flash                  # optional override, see lib/agent.ts

# Tavily — web search nástroj pro agenta (oba poskytovatele), zdarma bez
# karty (1000 hledání/měsíc): https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Telegram — create a bot via @BotFather, get chat id via @userinfobot / getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# Public URL of the deployed web app, used to build links in Telegram messages
NEXT_PUBLIC_WEB_URL=https://mozek.example.com
